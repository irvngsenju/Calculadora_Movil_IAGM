<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculadora_Movil_IAGM.Calculadora_movil"
             Title="Calculadora_movil">
    
    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="15">

        
        <Label x:Name="lblPantalla" 
               Grid.Row="0"
               Text="0" 
               FontSize="60" 
               TextColor="White" 
               HorizontalTextAlignment="End" 
               VerticalOptions="End"/>

        
        <Grid Grid.Row="1" 
              RowDefinitions="*, *, *, *" 
              ColumnDefinitions="*, *, *, *" 
              ColumnSpacing="10" 
              RowSpacing="10">

            
            <Button Text="C" Grid.Row="0" Grid.Column="0" Clicked="Button_Clicked" BackgroundColor="Gray" TextColor="White" FontSize="24"/>
            <Button Text="÷" Grid.Row="0" Grid.Column="1" Clicked="Button_Clicked" BackgroundColor="Orange" TextColor="White" FontSize="24"/>
            <Button Text="×" Grid.Row="0" Grid.Column="2" Clicked="Button_Clicked" BackgroundColor="Orange" TextColor="White" FontSize="24"/>
            <Button Text="-" Grid.Row="0" Grid.Column="3" Clicked="Button_Clicked" BackgroundColor="Orange" TextColor="White" FontSize="24"/>


            <Button Text="7" Grid.Row="1" Grid.Column="0" Clicked="Button_Clicked" BackgroundColor="#333" TextColor="White" FontSize="24"/>
            <Button Text="8" Grid.Row="1" Grid.Column="1" Clicked="Button_Clicked" BackgroundColor="#333" TextColor="White" FontSize="24"/>
            <Button Text="9" Grid.Row="1" Grid.Column="2" Clicked="Button_Clicked" BackgroundColor="#333" TextColor="White" FontSize="24"/>
            <Button Text="+" Grid.Row="1" Grid.Column="3" Grid.RowSpan="2" Clicked="Button_Clicked" BackgroundColor="Orange" TextColor="White" FontSize="24"/>


            <Button Text="4" Grid.Row="2" Grid.Column="0" Clicked="Button_Clicked" BackgroundColor="#333" TextColor="White" FontSize="24"/>
            <Button Text="5" Grid.Row="2" Grid.Column="1" Clicked="Button_Clicked" BackgroundColor="#333" TextColor="White" FontSize="24"/>
            <Button Text="6" Grid.Row="2" Grid.Column="2" Clicked="Button_Clicked" BackgroundColor="#333" TextColor="White" FontSize="24"/>


            <Button Text="1" Grid.Row="3" Grid.Column="0" Clicked="Button_Clicked" BackgroundColor="#333" TextColor="White" FontSize="24"/>
            <Button Text="2" Grid.Row="3" Grid.Column="1" Clicked="Button_Clicked" BackgroundColor="#333" TextColor="White" FontSize="24"/>
            <Button Text="3" Grid.Row="3" Grid.Column="2" Clicked="Button_Clicked" BackgroundColor="#333" TextColor="White" FontSize="24"/>
            <Button Text="=" Grid.Row="3" Grid.Column="3" Clicked="Button_Clicked" BackgroundColor="Orange" TextColor="White" FontSize="24"/>


        </Grid>
    </Grid>
</ContentPage>